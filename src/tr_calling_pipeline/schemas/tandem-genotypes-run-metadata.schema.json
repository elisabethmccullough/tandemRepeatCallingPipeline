{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umn.example/schemas/tandem-genotypes-run-metadata.schema.json",
  "title": "tandem-genotypes-run-metadata",
  "schema_version": "1.0",
  "type": "object",
  "required": [
    "record_schema_version",
    "run_id",
    "stage_id",
    "caller",
    "caller_version",
    "raw_version_output",
    "analysis_source",
    "associated_sequence_id",
    "assignment_state",
    "status",
    "alignment_identity",
    "repeat_definition_identity",
    "command_record_paths",
    "native_output_file_ids",
    "started_utc",
    "completed_utc",
    "warnings",
    "failure"
  ],
  "properties": {
    "record_schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "stage_id": {
      "const": "07_run_tandem_genotypes"
    },
    "caller": {
      "const": "TANDEM_GENOTYPES"
    },
    "caller_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_version_output": {
      "type": [
        "string",
        "null"
      ]
    },
    "analysis_source": {
      "const": "ASSEMBLED_CONTIG"
    },
    "associated_sequence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "assignment_state": {
      "const": "DIRECT_SEQUENCE_ASSOCIATION"
    },
    "status": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "DRY_RUN",
        "TOOL_MISSING",
        "INPUT_MISSING",
        "UNSUPPORTED_VERSION",
        "UNSUPPORTED_FORMAT",
        "NOT_COMPUTED"
      ]
    },
    "alignment_identity": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "repeat_definition_identity": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "command_record_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "native_output_file_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_utc": {
      "type": "string"
    },
    "completed_utc": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
