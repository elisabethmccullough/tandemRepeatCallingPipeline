{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "type": "object",
  "required": [
    "record_schema_version",
    "command_id",
    "stage_id",
    "tool_id",
    "argv",
    "status"
  ],
  "properties": {
    "record_schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED",
        "DRY_RUN",
        "OUTPUT_VALIDATION_FAILED"
      ]
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
