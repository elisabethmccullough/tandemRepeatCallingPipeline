{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "type": "object",
  "required": [
    "record_schema_version",
    "stage_id",
    "status",
    "configuration_digest"
  ],
  "properties": {
    "record_schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "PLANNED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "SKIPPED",
        "DRY_RUN",
        "INVALIDATED"
      ]
    }
  },
  "additionalProperties": true
}
