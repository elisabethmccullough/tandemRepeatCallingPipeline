{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version",
    "package_id",
    "valid",
    "error_count",
    "warning_count",
    "issues"
  ],
  "properties": {
    "record_schema_version": {
      "const": "1.0"
    },
    "package_id": {
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "severity",
          "code",
          "message",
          "artifact_path",
          "record_id",
          "source_file_id",
          "caller"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "ERROR",
              "WARNING",
              "INFO"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "artifact_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_file_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "caller": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
