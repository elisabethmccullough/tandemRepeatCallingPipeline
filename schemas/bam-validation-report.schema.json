{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "valid",
    "bam_path",
    "index_path",
    "sort_order",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "valid": {
      "type": "boolean"
    },
    "bam_path": {
      "type": "string"
    },
    "index_path": {
      "type": "string"
    },
    "sort_order": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    }
  }
}
